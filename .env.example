# Local development through `adb forward tcp:3000 tcp:3000`
IRIS_BASE_URL=http://127.0.0.1:3000

BOT_COMMAND=!핑
BOT_REPLY=퐁

# Empty means that every room/sender may use the exact BOT_COMMAND.
# Before production, set comma-separated Iris chat_id/user_id values.
BOT_ALLOWED_ROOM_IDS=
BOT_ALLOWED_SENDER_IDS=

# Local default. In production, ROOM_DATABASE_URL selects PostgreSQL instead.
ROOM_DATABASE_PATH=data/kakao_bot.db
# ROOM_DATABASE_URL=postgresql://kakao_bot_app:change-me@pickty-postgres:5432/kakao_bot
REGISTRATION_CODE_TTL_SECONDS=600
REGISTRATION_CODE_MAX_ATTEMPTS_PER_ROOM=5
MESSAGE_RETENTION_DAYS=30
MESSAGE_MAX_CHARS=4000

IRIS_REQUEST_TIMEOUT_SECONDS=5
IRIS_RECONNECT_INITIAL_SECONDS=1
IRIS_RECONNECT_MAX_SECONDS=30
BOT_DEDUP_CACHE_SIZE=1000

# Discord /카톡 bridge. Keep the token and bridge secret out of Git.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Empty allows the command in every channel of the configured guild.
DISCORD_CHANNEL_ID=
# If both are empty, every member of the configured guild/channel may use it.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_KAKAO_ROOM_ID=
DISCORD_BRIDGE_SECRET=
DISCORD_BRIDGE_API_URL=http://kakao-bot:8000
DISCORD_MAX_MESSAGE_CHARS=1000

APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
